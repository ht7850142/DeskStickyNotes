<Window x:Class="DeskStickyNotes.Views.TextClipPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource TextClipPreviewTitle}"
        Icon="/Assets/AppIcon.ico"
        Width="720"
        Height="560"
        MinWidth="480"
        MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F7"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="14"
            Background="White"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.16"
                              Color="#111827" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="22,18"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left"
                            Width="40"
                            Height="40"
                            Margin="0,0,12,0"
                            Background="#E8F0FF"
                            CornerRadius="9">
                        <Viewbox Width="20" Height="20">
                            <Path Fill="Transparent"
                                  Stroke="#2563EB"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M5,2H14L19,7V22H5V2ZM14,2V7H19M8,12H16M8,16H16M8,20H13" />
                        </Viewbox>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleTextBlock"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MetadataTextBlock"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBox x:Name="ContentTextBox"
                     AutomationProperties.Name="{DynamicResource TextClipPreviewContent}"
                     Grid.Row="1"
                     Margin="18"
                     Padding="14,12"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     BorderBrush="{StaticResource PanelBorderBrush}"
                     BorderThickness="1"
                     Background="#FCFCFD"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                     FontSize="13"
                     SelectionBrush="#93C5FD"
                     SpellCheck.IsEnabled="False" />

            <Border Grid.Row="2"
                    Padding="18,12"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <DockPanel LastChildFill="False">
                    <StackPanel x:Name="WrapOptionPanel"
                                DockPanel.Dock="Left"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                MouseLeftButtonDown="WrapOption_MouseLeftButtonDown">
                        <CheckBox x:Name="WrapTextCheckBox"
                                  AutomationProperties.Name="{DynamicResource TextClipPreviewWrap}"
                                  VerticalAlignment="Center"
                                  Checked="WrapTextCheckBox_Changed"
                                  Unchecked="WrapTextCheckBox_Changed" />
                        <TextBlock Text="{DynamicResource TextClipPreviewWrap}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal">
                        <Button x:Name="CopyButton"
                                Content="{DynamicResource TextClipPreviewCopy}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CopyButton_Click" />
                        <Button Content="{DynamicResource ButtonClose}"
                                Margin="10,0,0,0"
                                IsDefault="True"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
