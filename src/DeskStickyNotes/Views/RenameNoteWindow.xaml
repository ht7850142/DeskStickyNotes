<Window x:Class="DeskStickyNotes.Views.RenameNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DeskStickyNotes.Models"
        Title="{DynamicResource RenameNoteTitle}"
        Icon="/Assets/AppIcon.ico"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="#F8FAFC">
    <StackPanel Margin="20">
        <TextBlock Text="{DynamicResource RenameNoteTitle}" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock Text="{DynamicResource RenameNoteDescription}" Margin="0,8,0,16" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" />
        <Label Content="{DynamicResource RenameNoteLabel}" Target="{Binding ElementName=TitleTextBox}"
               Padding="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" />
        <TextBox x:Name="TitleTextBox" Height="36" Padding="9,5"
                 MaxLength="{x:Static models:NoteModel.MaximumTitleLength}"
                 AutomationProperties.Name="{DynamicResource RenameNoteLabel}"
                 BorderBrush="{StaticResource PanelBorderBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{DynamicResource ButtonCancel}" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="{DynamicResource ButtonSave}" Margin="10,0,0,0" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
