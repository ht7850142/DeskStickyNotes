<Window x:Class="DeskStickyNotes.Views.HyperlinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource HyperlinkDialogTitle}"
        Icon="/Assets/AppIcon.ico"
        Width="430"
        Height="335"
        MinWidth="360"
        MinHeight="315"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource HyperlinkDialogTitle}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" />

        <TextBlock Grid.Row="1"
                   Text="{DynamicResource HyperlinkDialogHint}"
                   Margin="0,8,0,14"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="{DynamicResource HyperlinkDialogText}"
                       Margin="0,0,0,6"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontWeight="SemiBold" />
            <TextBox x:Name="DisplayTextBox"
                     Height="34"
                     Padding="9,5"
                     BorderBrush="{StaticResource PanelBorderBrush}"
                     TextChanged="Input_TextChanged"
                     KeyDown="Input_KeyDown" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Margin="0,14,0,0">
            <TextBlock Text="{DynamicResource HyperlinkDialogUrl}"
                       Margin="0,0,0,6"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontWeight="SemiBold" />
            <TextBox x:Name="UrlTextBox"
                     Height="34"
                     Padding="9,5"
                     BorderBrush="{StaticResource PanelBorderBrush}"
                     TextChanged="Input_TextChanged"
                     KeyDown="Input_KeyDown" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="{DynamicResource HyperlinkDialogCancel}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Cancel_Click" />
            <Button x:Name="InsertButton"
                    Content="{DynamicResource HyperlinkDialogOk}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="10,0,0,0"
                    Click="Insert_Click" />
        </StackPanel>
    </Grid>
</Window>
