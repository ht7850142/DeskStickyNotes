<Window x:Class="DeskStickyNotes.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DeskStickyNotes.Models"
        Title="{DynamicResource AppName}"
        Icon="/Assets/AppIcon.ico"
        Width="{Binding Width, Mode=OneWay}"
        Height="{Binding Height, Mode=OneWay}"
        Left="{Binding X, Mode=OneWay}"
        Top="{Binding Y, Mode=OneWay}"
        MinWidth="{x:Static models:NoteModel.MinWidth}"
        MinHeight="{x:Static models:NoteModel.MinHeight}"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        ShowActivated="False"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        Topmost="{Binding Topmost, Mode=OneWay}"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="WindowResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="{DynamicResource TipResizeNote}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="DragStarted" Handler="WindowResizeThumb_DragStarted" />
            <EventSetter Event="DragDelta" Handler="WindowResizeThumb_DragDelta" />
            <EventSetter Event="DragCompleted" Handler="WindowResizeThumb_DragCompleted" />
        </Style>
    </Window.Resources>
    <Border x:Name="WindowChrome"
            Margin="8"
            Background="{Binding BackgroundHex}"
            CornerRadius="8"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect x:Name="WindowChromeShadow"
                              BlurRadius="16"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.16"
                              Color="#111827" />
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Border x:Name="CollapsedIconContent"
                    Visibility="Collapsed"
                    Background="Transparent"
                    Focusable="True"
                    AutomationProperties.Name="{Binding Text, ElementName=NoteTitleText}"
                    Cursor="Hand"
                    ToolTip="{DynamicResource TipRestoreNote}"
                    MouseLeftButtonDown="CollapsedIcon_MouseLeftButtonDown"
                    MouseMove="CollapsedIcon_MouseMove"
                    MouseLeftButtonUp="CollapsedIcon_MouseLeftButtonUp">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource RenameNoteTitle}" InputGestureText="F2" Click="RenameNote_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Image Width="44"
                       Height="44"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="{StaticResource AppMark}" />
            </Border>

            <Grid x:Name="ExpandedContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{Binding HeaderHex}"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="DragBar_MouseLeftButtonDown"
                    MouseMove="DragBar_MouseMove"
                    MouseLeftButtonUp="DragBar_MouseLeftButtonUp">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource RenameNoteTitle}" InputGestureText="F2" Click="RenameNote_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel Margin="10,7,8,7" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button ToolTip="{DynamicResource TipChangeColor}"
                                Style="{StaticResource IconButtonStyle}"
                                Click="ColorButton_Click">
                            <Border Width="18"
                                    Height="18"
                                    CornerRadius="9"
                                    Background="{Binding SwatchHex}"
                                    BorderBrush="{Binding BorderHex}"
                                    BorderThickness="1.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3"
                                                      ShadowDepth="0"
                                                      Opacity="0.16"
                                                      Color="#111827" />
                                </Border.Effect>
                            </Border>
                        </Button>
                        <Button Style="{StaticResource TopmostButtonStyle}"
                                Command="{Binding ToggleTopmostCommand}">
                            <Path Width="15"
                                  Height="15"
                                  Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M16,2H8V4H9V11.2L7,13.2V15H11.2V22H12.8V15H17V13.2L15,11.2V4H16V2Z" />
                        </Button>
                        <Button ToolTip="{DynamicResource TipCollapseNote}"
                                Style="{StaticResource IconButtonStyle}"
                                Click="CollapseButton_Click">
                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M3,1H15V13H3Z M7,5H12V10 M12,5L6,11" />
                        </Button>
                        <Button ToolTip="{DynamicResource TipNoteMenu}"
                                Style="{StaticResource IconButtonStyle}" Click="NoteMenuButton_Click">
                            <Path Width="16" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M1,2A1.5,1.5 0 1 0 4,2A1.5,1.5 0 1 0 1,2 M7,2A1.5,1.5 0 1 0 10,2A1.5,1.5 0 1 0 7,2 M13,2A1.5,1.5 0 1 0 16,2A1.5,1.5 0 1 0 13,2" />
                        </Button>
                    </StackPanel>

                    <DockPanel VerticalAlignment="Center">
                        <Button DockPanel.Dock="Left"
                                Width="24"
                                Height="28"
                                Margin="0,0,5,0"
                                FontSize="18"
                                FontWeight="SemiBold"
                                ToolTip="{DynamicResource TrayNewNote}"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding NewNoteCommand}">
                            <Path Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Data="M0,7H14 M7,0V14" />
                        </Button>
                        <Border Width="1"
                                DockPanel.Dock="Left"
                                Height="16"
                                Margin="1,0,10,0"
                                CornerRadius="3"
                                Background="#28454C45" />
                        <TextBlock x:Name="NoteTitleText"
                                   Text="{DynamicResource NoteTitle}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource NoteControlBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                    </DockPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    MinHeight="38"
                    Background="#38FFFFFF"
                    BorderBrush="#14000000" BorderThickness="0,0,0,1">
                <DockPanel Margin="10,4,10,4">
                    <WrapPanel x:Name="EditorToolbar"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                KeyboardNavigation.TabNavigation="Continue">
                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                            <Button Content="B"
                                    ToolTip="{DynamicResource TipBold}"
                                    Style="{StaticResource EditorToolButtonStyle}"
                                    Click="EditorToolButton_Click"
                                    Tag="Bold" />
                            <Button Content="I"
                                    FontStyle="Italic"
                                    ToolTip="{DynamicResource TipItalic}"
                                    Style="{StaticResource EditorToolButtonStyle}"
                                    Click="EditorToolButton_Click"
                                    Tag="Italic" />
                            <Button ToolTip="{DynamicResource TipUnderline}"
                                    Style="{StaticResource EditorToolButtonStyle}"
                                    Click="EditorToolButton_Click"
                                    Tag="Underline">
                                <TextBlock Text="U" TextDecorations="Underline" />
                            </Button>
                            <Button ToolTip="{DynamicResource TipStrikethrough}"
                                    Style="{StaticResource EditorToolButtonStyle}"
                                    Click="EditorToolButton_Click"
                                    Tag="Strike">
                                <TextBlock Text="S" TextDecorations="Strikethrough" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                            <Button Content="•"
                                    ToolTip="{DynamicResource TipBulletList}"
                                    Style="{StaticResource EditorToolButtonStyle}"
                                    Click="EditorToolButton_Click"
                                    Tag="Bullet" />
                            <Button Content="1."
                                    ToolTip="{DynamicResource TipNumberList}"
                                    Style="{StaticResource EditorToolButtonStyle}"
                                    Click="EditorToolButton_Click"
                                    Tag="Number" />
                            <Button Content="☐"
                                    ToolTip="{DynamicResource TipTodo}"
                                    Style="{StaticResource EditorToolButtonStyle}"
                                    Click="EditorToolButton_Click"
                                    Tag="Todo" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                            <Button ToolTip="{DynamicResource TipHyperlink}"
                                    Style="{StaticResource EditorToolButtonStyle}"
                                    Click="HyperlinkButton_Click">
                                <Path Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M7,10L11,6 M6,7L4,9C1,12 5,16 8,13L10,11 M8,5L10,3C13,0 17,4 14,7L12,9" />
                            </Button>
                            <Button ToolTip="{DynamicResource TipTextClip}"
                                    AutomationProperties.Name="{DynamicResource TipTextClip}"
                                    Focusable="True"
                                    Style="{StaticResource EditorToolButtonStyle}"
                                    Click="TextClipButton_Click">
                                <Viewbox Width="14" Height="14">
                                    <Path Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M4,1H11L15,5V17H4V1ZM11,1V5H15M6.5,9H12.5M6.5,12H12.5M6.5,15H10.5" />
                                </Viewbox>
                            </Button>
                            <Button Content="H"
                                    ToolTip="{DynamicResource TipHeadingStyle}"
                                    Style="{StaticResource EditorToolButtonStyle}"
                                    Click="HeadingButton_Click"
                                    FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0">
                            <Button ToolTip="{DynamicResource TipAlignLeft}"
                                    Style="{StaticResource EditorToolButtonStyle}"
                                    Click="EditorToolButton_Click"
                                    Tag="AlignLeft">
                                <Grid Width="14" Height="14">
                                    <Rectangle Width="14" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="#344054" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <Rectangle Width="10" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="#344054" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0" />
                                    <Rectangle Width="13" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="#344054" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0" />
                                </Grid>
                            </Button>
                            <Button ToolTip="{DynamicResource TipAlignCenter}"
                                    Style="{StaticResource EditorToolButtonStyle}"
                                    Click="EditorToolButton_Click"
                                    Tag="AlignCenter">
                                <Grid Width="14" Height="14">
                                    <Rectangle Width="14" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="#344054" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <Rectangle Width="10" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="#344054" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" />
                                    <Rectangle Width="13" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="#344054" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" />
                                </Grid>
                            </Button>
                            <Button ToolTip="{DynamicResource TipAlignRight}"
                                    Style="{StaticResource EditorToolButtonStyle}"
                                    Click="EditorToolButton_Click"
                                    Tag="AlignRight">
                                <Grid Width="14" Height="14">
                                    <Rectangle Width="14" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="#344054" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <Rectangle Width="10" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="#344054" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0" />
                                    <Rectangle Width="13" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="#344054" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,0,0" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <RichTextBox x:Name="Editor"
                             FontSize="{Binding FontSize}"
                             FontFamily="{DynamicResource UiFontFamily}"
                             Foreground="{Binding TextForegroundHex}"
                             CaretBrush="#2563EB"
                             SelectionBrush="#93C5FD"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="15,12,14,12"
                             AllowDrop="True"
                             AcceptsTab="True"
                             IsDocumentEnabled="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="Editor_PreviewKeyDown"
                             AutomationProperties.Name="{DynamicResource NoteEditorName}"
                             SelectionChanged="Editor_SelectionChanged"
                             TextChanged="Editor_TextChanged">
                    <RichTextBox.Resources>
                        <Style TargetType="Paragraph">
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="LineHeight" Value="22" />
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>

                <TextBlock x:Name="EmptyNoteHint" Margin="17,14,30,0"
                           VerticalAlignment="Top" IsHitTestVisible="False"
                           Text="{DynamicResource EmptyNoteHint}" TextWrapping="Wrap"
                           Foreground="{Binding TextForegroundHex}" Opacity="0.72" FontSize="14" />

                <Border x:Name="TextFileDropOverlay"
                        Margin="8"
                        Padding="10"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Background="#F2FFFFFF"
                        BorderBrush="#7C9DCC"
                        BorderThickness="1.5"
                        CornerRadius="9">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16"
                                          ShadowDepth="1"
                                          Direction="270"
                                          Opacity="0.16"
                                          Color="#111827" />
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="32"
                                Height="32"
                                HorizontalAlignment="Center"
                                Background="#E8F0FF"
                                CornerRadius="12">
                            <Viewbox Width="18" Height="18">
                                <Path Fill="Transparent"
                                      Stroke="#2563EB"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M5,2H14L19,7V22H5V2ZM14,2V7H19M8,12H16M8,16H16M8,20H13" />
                            </Viewbox>
                        </Border>
                        <TextBlock Text="{DynamicResource TextClipDropTitle}"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource TextClipDropHint}"
                                   Margin="0,3,0,0"
                                   MaxWidth="300"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10" />
                    </StackPanel>
                </Border>

                <Path Width="12"
                      Height="12"
                      Margin="0,0,5,5"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      IsHitTestVisible="False"
                      Fill="{Binding TextForegroundHex}"
                      Opacity="0.35"
                      Data="M9,1A1,1 0 1 0 11,1A1,1 0 1 0 9,1 M5,5A1,1 0 1 0 7,5A1,1 0 1 0 5,5 M9,5A1,1 0 1 0 11,5A1,1 0 1 0 9,5 M1,9A1,1 0 1 0 3,9A1,1 0 1 0 1,9 M5,9A1,1 0 1 0 7,9A1,1 0 1 0 5,9 M9,9A1,1 0 1 0 11,9A1,1 0 1 0 9,9" />
            </Grid>
            </Grid>

            <!-- Place hit targets over the painted note, not the transparent shadow margin. -->
            <Grid x:Name="WindowResizeHandles">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="Maximized">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Thumb Style="{StaticResource WindowResizeThumbStyle}" Tag="Left"
                       Width="6" Margin="0,14,0,14" HorizontalAlignment="Left" Cursor="SizeWE" />
                <Thumb Style="{StaticResource WindowResizeThumbStyle}" Tag="Right"
                       Width="6" Margin="0,14,0,14" HorizontalAlignment="Right" Cursor="SizeWE" />
                <Thumb Style="{StaticResource WindowResizeThumbStyle}" Tag="Top"
                       Height="6" Margin="14,0,14,0" VerticalAlignment="Top" Cursor="SizeNS" />
                <Thumb Style="{StaticResource WindowResizeThumbStyle}" Tag="Bottom"
                       Height="6" Margin="14,0,18,0" VerticalAlignment="Bottom" Cursor="SizeNS" />
                <Thumb Style="{StaticResource WindowResizeThumbStyle}" Tag="TopLeft"
                       Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" />
                <Thumb Style="{StaticResource WindowResizeThumbStyle}" Tag="TopRight"
                       Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" />
                <Thumb Style="{StaticResource WindowResizeThumbStyle}" Tag="BottomLeft"
                       Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" />
                <Thumb Style="{StaticResource WindowResizeThumbStyle}" Tag="BottomRight"
                       Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                       ToolTip="{DynamicResource TipResizeNote}" />
            </Grid>
        </Grid>
    </Border>
</Window>
